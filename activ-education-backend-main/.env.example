# =============================================================================
# ACTIV EDUCATION — Variables d'environnement (exemple)
# =============================================================================
# Copier ce fichier en .env et remplir toutes les valeurs
# cp .env.example .env
# =============================================================================

# ─── Base de données ─────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=activ_education
DB_USER=postgres
DB_PASSWORD=postgres

# ─── JPA ─────────────────────────────────────────────────────────────────────
JPA_DDL_AUTO=update

# ─── Serveur ─────────────────────────────────────────────────────────────────
SERVER_PORT=8080

# ─── MinIO (Stockage fichiers) ───────────────────────────────────────────────
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET_IMAGES=activeducation-images
MINIO_BUCKET_VIDEOS=activeducation-videos
MINIO_BUCKET_DOCUMENTS=activeducation-documents

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT (Authentification) ──────────────────────────────────────────────────
# Générer une clé 512-bit : openssl rand -base64 64
JWT_SECRET=changer_ici_avec_openssl_rand_-base64_64
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ─── OpenAI (Embedding + Fallback Chat + OCR) ────────────────────────────────
OPENAI_API_KEY=sk-proj-votre-cle-openai-ici

# ─── Groq (Chat ORIA — fallback si OpenAI indisponible) ──────────────────────
GROQ_API_KEY=gsk_votre-cle-groq-ici

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW=15
RATE_LIMIT_REFRESH_MAX=20
RATE_LIMIT_REFRESH_WINDOW=5
RATE_LIMIT_API_MAX=200
RATE_LIMIT_API_WINDOW=1
