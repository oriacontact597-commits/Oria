# =============================================================================
# ACTIV EDUCATION — Variables d'environnement Production
# =============================================================================
# Copier ce fichier en .env.prod et remplir toutes les valeurs
# cp .env.prod.example .env.prod
# =============================================================================

# ─── Base de données ─────────────────────────────────────────────────────────
DB_PASSWORD=changer_moi_password_fort_123

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=changer_moi_redis_456

# ─── MinIO (Stockage fichiers) ───────────────────────────────────────────────
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=changer_moi_minio_789

# ─── JWT (Authentification) ──────────────────────────────────────────────────
# Générer une clé 512-bit : openssl rand -base64 64
JWT_SECRET=ouvrir_un_terminal_taper_openssl_rand_-base64_64_et_copier_ici

# ─── OpenAI (Embedding + Fallback Chat) ──────────────────────────────────────
OPENAI_API_KEY=sk-proj-votre-cle-openai-ici

# ─── Groq (Chat ORIA — fallback si OpenAI indisponible) ──────────────────────
GROQ_API_KEY=gsk_votre-cle-groq-ici

# ─── Domaine ─────────────────────────────────────────────────────────────────
# Utilisé par l'application mobile pour atteindre l'API
VITE_API_BASE_URL=https://activeducation.tg/api/v1
API_BASE_URL=https://activeducation.tg

# ─── Optionnel ───────────────────────────────────────────────────────────────
# Twilio SMS (rappels RDV)
# SMS_PROVIDER=twilio
# SMS_API_KEY=...
# SMS_SENDER=...

# Firebase (notifications push)
# FCM_SERVER_KEY=...
